# NASA Earthdata credentials  (register free at https://urs.earthdata.nasa.gov/)
NASA_EARTHDATA_USERNAME=your_earthdata_username
NASA_EARTHDATA_PASSWORD=your_earthdata_password

# NASA Open APIs key (free, register at https://api.nasa.gov/)
NASA_API_KEY=DEMO_KEY

# Optional: USGS EarthExplorer credentials
USGS_USERNAME=
USGS_PASSWORD=

# Pipeline behaviour
PIPELINE_LOG_LEVEL=INFO
PIPELINE_MAX_RETRIES=3
PIPELINE_TIMEOUT_SECONDS=120

# Bounding box for Earth region of interest (decimal degrees, WGS84)
# Default: Atacama Desert, Chile – a well-known Mars analogue
EARTH_BBOX_WEST=-70.0
EARTH_BBOX_SOUTH=-24.5
EARTH_BBOX_EAST=-68.0
EARTH_BBOX_NORTH=-22.0
