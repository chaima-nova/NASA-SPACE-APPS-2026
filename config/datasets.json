    {
      "id": "srtm_gl1",
      "name": "SRTM Global 1 Arc-Second DEM (GL1)",
      "planetary_body": "earth",
      "category": "elevation",
      "enabled": true,
      "source_agency": "NASA / USGS / DLR",
      "mission_or_instrument": "Shuttle Radar Topography Mission (SRTM)",
      "landing_page": "https://lpdaac.usgs.gov/products/srtmgl1v003/",
      "download_endpoint": "https://e4ftl01.cr.usgs.gov/MEASURES/SRTMGL1.003/2000.02.11/",
      "access_method": "earthdata_https",
      "format": "HGT / GeoTIFF",
      "units": {"elevation": "meters above WGS84 ellipsoid"},
      "spatial_resolution": "~30m at equator",
      "temporal_coverage": "February 2000 (single acquisition)",
      "crs": "EPSG:4326 (WGS84 geographic)",
      "authentication_required": true,
      "auth_method": "NASA Earthdata (username/password in .env)",
      "expected_size_per_tile": "~25 MB (1°×1° HGT tile)",
      "license": "NASA/USGS open data – attribution required",
      "scientific_notes": "Gold-standard 30m global DEM. Use for Earth slope, roughness. Voids filled by NASA.",
      "limitations": "Voids in steep/shadowed terrain; radar penetrates vegetation canopy.",
      "tags": ["elevation", "terrain", "dem", "earth", "analogue"],
      "local_raw_dir": "data/raw/earth/srtm_gl1",
      "processing": {
        "derive_slope": true,
        "derive_roughness": true,
        "output_crs": "EPSG:4326"
      }
    },

